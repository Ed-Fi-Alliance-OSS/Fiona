{
  "name": "ed-fi-fiona",
  "version": "1.0.0",
  "description": "An AI assistant for Ed-Fi data standards, built using the Slack Bolt framework.",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "lint": "npx @biomejs/biome check src/",
    "lint:fix": "npx @biomejs/biome check --write src/",
    "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js",
    "test:ci": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --coverage --reporters=default --reporters=jest-junit",
    "setup:emulator": "node scripts/setup-cosmos-emulator.js",
    "load:slack-users": "node scripts/load-slack-users.js"
  },
  "author": "Ed-Fi Alliance, LLC",
  "license": "Apache-2.0",
  "keywords": [
    "slack",
    "ed-fi",
    "fiona"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ed-Fi-Alliance-OSS/Fiona"
  },
  "bugs": {
    "url": "https://github.com/Ed-Fi-Alliance-OSS/Fiona/issues"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.1",
    "@azure/identity": "^4.13.0",
    "@slack/bolt": "^4.6.0",
    "axios": "^1.18.1",
    "dotenv": "~17.3.1",
    "openai": "^6.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@jest/globals": "^29.7.0",
    "@slack/cli-hooks": "^1.3.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0"
  }
}
