# Optional, uncomment and set when running without the Slack CLI (npm start).
# SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
# SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=YOUR_SLACK_API_URL

# Optional, set the Bolt log level (debug, info, warn, error). Defaults to info.
# LOG_LEVEL=info

# Required, set your OpenAI API key.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Optional, set for standard Azure OpenAI Service.
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/
# AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
# AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
# AZURE_OPENAI_API_VERSION=2024-05-01-preview

# Azure AI Foundry Agent (uses Entra ID auth - see README, run `az login` first)
# AZURE_PROJECT_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT
# AZURE_AGENT_ID=YOUR_AGENT_ID

# Optional, set for Perplexity Sonar API.
# PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY
# PERPLEXITY_API_MODEL=sonar
# Optional, comma-separated list of domains to restrict Perplexity searches to.
# Defaults to www.ed-fi.org,docs.ed-fi.org
# PERPLEXITY_DOMAIN_FILTER=www.ed-fi.org,docs.ed-fi.org

# Optional, select the primary LLM provider (openai, azure, foundry, perplexity).
# Defaults to foundry if AZURE_PROJECT_ENDPOINT is set, else azure, else openai.
# LLM_PROVIDER=perplexity

# Deployment type label recorded with feedback in Cosmos DB (local, insiders, production).
DEPLOYMENT_TYPE=local

# Optional, Cosmos DB for feedback storage. Supports three auth methods (in priority order):
#   1. Connection string:  set COSMOS_CONNECTION_STRING
#   2. Endpoint + key:     set COSMOS_ENDPOINT and COSMOS_KEY
#   3. Managed identity:   set COSMOS_ENDPOINT only (uses DefaultAzureCredential)
# If none are set, feedback is acknowledged to the user but not persisted.
# COSMOS_CONNECTION_STRING=AccountEndpoint=https://YOUR_ACCOUNT.documents.azure.com:443/;AccountKey=...
# COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/
# COSMOS_KEY=YOUR_COSMOS_KEY
# COSMOS_DATABASE=fiona
# COSMOS_CONTAINER=feedback

# Optional, rate limiting per user (sliding window).
# Set RATE_LIMIT_MAX_REQUESTS=0 to disable rate limiting entirely.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=3600000

# Optional, override the default system prompt sent to the LLM.
# Not used for the 'foundry' provider (system prompt is configured in Azure AI Foundry portal).
# SYSTEM_PROMPT=Your custom system prompt here.
