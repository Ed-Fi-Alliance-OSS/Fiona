# Slack credentials — obtain from https://api.slack.com/apps
# Required for both `npm start` (direct) and `slack run` (via Slack CLI)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# LLM provider — set to one of: openai, azure, foundry, perplexity
LLM_PROVIDER=perplexity

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Azure OpenAI (required when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Azure AI Foundry (required when LLM_PROVIDER=foundry)
AZURE_AI_PROJECT_ENDPOINT=

# Perplexity (required when LLM_PROVIDER=perplexity)
PERPLEXITY_API_KEY=

# Azure Cosmos DB for feedback persistence (all optional)
# Option 1 — connection string (highest priority)
COSMOS_CONNECTION_STRING=
# Option 2 — endpoint + key
COSMOS_ENDPOINT=
COSMOS_KEY=
# Option 3 — endpoint only (uses DefaultAzureCredential / managed identity)
# COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/

COSMOS_DATABASE=fiona
COSMOS_CONTAINER=feedback
