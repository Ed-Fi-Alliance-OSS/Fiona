# Optional, uncomment and set when running without the Slack CLI (npm start).
# SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
# SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=YOUR_SLACK_API_URL

# Optional, set the Bolt log level (debug, info, warn, error). Defaults to info.
# LOG_LEVEL=info

# Required, set your Perplexity Sonar API key.
# PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY
# PERPLEXITY_API_MODEL=sonar
# Optional, comma-separated list of domains to restrict Perplexity searches to.
# Defaults to www.ed-fi.org,docs.ed-fi.org
# PERPLEXITY_DOMAIN_FILTER=www.ed-fi.org,docs.ed-fi.org

# Deployment type label recorded with feedback in Cosmos DB (local, insiders, production).
DEPLOYMENT_TYPE=local

# Optional, Cosmos DB for feedback and conversation storage. Supports three auth methods (in priority order):
#   1. Connection string:  set COSMOS_CONNECTION_STRING
#   2. Endpoint + key:     set COSMOS_ENDPOINT and COSMOS_KEY
#   3. Managed identity:   set COSMOS_ENDPOINT only (uses DefaultAzureCredential)
# If none are set, feedback is acknowledged to the user but not persisted.
# COSMOS_CONNECTION_STRING=AccountEndpoint=https://YOUR_ACCOUNT.documents.azure.com:443/;AccountKey=...
# COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/
# COSMOS_KEY=YOUR_COSMOS_KEY
# COSMOS_DATABASE=chatbot
# COSMOS_CONTAINER=feedback
# COSMOS_USERS_CONTAINER=slack-users
# COSMOS_INTERACTIONS_CONTAINER=interactions
# COSMOS_CONVERSATIONS_CONTAINER=conversations

# Optional, set to true to capture all conversations to Cosmos DB for analysis.
# Requires Cosmos DB to be configured above.
# CAPTURE_ALL_CONVERSATIONS=false

# Optional, rate limiting per user (sliding window).
# Set RATE_LIMIT_MAX_REQUESTS=0 to disable rate limiting entirely.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=3600000

# Optional, override the default system prompt sent to the LLM.
# SYSTEM_PROMPT=Your custom system prompt here.

# Escalation (/fiona escalate). ESCALATION_CHANNEL_ID is the destination channel ID
# (e.g. C0123456789) — the bot must be a member of that channel to post.
# ESCALATION_CHANNEL_ID=C0123456789
# Optional: a Slack user group ID (e.g. S0123456789) to @-mention on escalation.
# ESCALATION_USERGROUP_ID=S0123456789

# GitHub issue creation (/fiona bug|feature). GitHub GraphQL API, fine-grained PAT.
# SLACK_GITHUB_ISSUE_REPO=Ed-Fi-Alliance-OSS/Fiona
# SLACK_GITHUB_ISSUE_TOKEN=YOUR_FINE_GRAINED_PAT
# Optional: REST base override for GitHub Enterprise Server (the GraphQL endpoint is
# derived from it: /api/v3 -> /api/graphql). Defaults to https://api.github.com.
# GITHUB_API_URL=https://api.github.com
# Optional native issue TYPE overrides (defaults: Bug / Feature). Issues get a real
# GitHub issue type, not a label. The types MUST already exist in the org.
# SLACK_GITHUB_ISSUE_BUG_TYPE_NAME=Bug
# SLACK_GITHUB_ISSUE_FEATURE_TYPE_NAME=Feature
# Optional: names of the org-level issue fields Fiona writes. Both are resolved to
# node IDs at request time, so use the human-readable names, not the IDs. Each field
# must already exist and be readable by the PAT.
# SLACK_GITHUB_ISSUE_SLACK_USER_FIELD_NAME=Slack User
# The Priority field is a single-select; its option names must match PRIORITY_OPTIONS
# in src/listeners/views/ticket_modal.js exactly (Urgent / High / Medium / Low).
# SLACK_GITHUB_ISSUE_PRIORITY_FIELD_NAME=Priority

# Optional approval gate for issue creation. When true AND a triage channel is set,
# Fiona posts a draft with Approve/Discard buttons instead of creating immediately.
# TICKET_APPROVAL_REQUIRED=false
# TICKET_TRIAGE_CHANNEL_ID=C0123456789
