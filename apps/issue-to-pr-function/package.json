{
  "name": "issue-to-pr-function",
  "version": "1.0.0",
  "description": "Azure Durable Functions app that automates TDD-driven draft PRs from agent-ready GitHub issues",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 func start",
    "lint": "npx @biomejs/biome check src/ test/",
    "lint:fix": "npx @biomejs/biome check --write src/ test/",
    "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js",
    "test:ci": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --coverage --reporters=default --reporters=jest-junit"
  },
  "author": "Ed-Fi Alliance, LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ed-Fi-Alliance-OSS/Fiona"
  },
  "bugs": {
    "url": "https://github.com/Ed-Fi-Alliance-OSS/Fiona/issues"
  },
  "dependencies": {
    "@azure/ai-projects": "^1.0.0-beta.8",
    "@azure/cosmos": "^4.1.0",
    "@azure/functions": "^4.6.0",
    "@azure/identity": "^4.0.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "durable-functions": "^3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@jest/globals": "^29.7.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jest-junit": "^17.0.0"
  }
}
