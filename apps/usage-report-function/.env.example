# Cosmos DB endpoint URL (used with managed identity auth via DefaultAzureCredential)
# Run `az login` locally before starting the function.
COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/

# Cosmos DB database and container names
COSMOS_DATABASE=chatbot
COSMOS_INTERACTIONS_CONTAINER=interactions
COSMOS_FEEDBACK_CONTAINER=feedback

# Deployment type label used to filter analytics data (local, insiders, production)
DEPLOYMENT_TYPE=local

# Azure Key Vault URL — the webhook URL is retrieved from here at runtime
KEY_VAULT_URL=https://YOUR_KEYVAULT.vault.azure.net/

# Name of the Key Vault secret that holds the Slack incoming webhook URL
# Defaults to 'slack-fiona-weekly-report-webhook' if not set
SLACK_WEBHOOK_KEYVAULT_SECRET_NAME=slack-fiona-weekly-report-webhook

# Cron schedule for the timer trigger (Azure Functions cron syntax: sec min hr day month weekday)
# Defaults to the value of the REPORT_SCHEDULE app setting when deployed.
# Example: every Monday at 8:00 AM UTC
REPORT_SCHEDULE=0 0 8 * * 1
